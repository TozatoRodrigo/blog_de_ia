---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { topics } from '../../../data/topics';
import { SITE } from '../../../config';
import { t, ta } from '../../../i18n/lang';
import { ui } from '../../../i18n/ui';

const lang = 'en' as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${ui('topics.title', lang)} — ${SITE.name}`,
  description: ui('topics.description', lang),
  url: `${SITE.url}/en/topics`,
  inLanguage: 'en',
};
---

<BaseLayout
  title={ui('topics.title', lang)}
  description={ui('topics.description', lang)}
  jsonLd={jsonLd}
  lang={lang}
  alternateUrl="/topicos"
>
  <section class="container" style="padding-top: 3rem; padding-bottom: 2rem;">
    <div class="section-header">
      <div>
        <span class="mono" style="color: var(--accent);">[ {ui('topics.coverageMap', lang)} ]</span>
        <h1>{ui('topics.title', lang)}</h1>
      </div>
      <span class="mono" style="color: var(--fg-muted);">{topics.length} {ui('topics.title', lang).toUpperCase()}</span>
    </div>
    <p style="font-size: var(--step-1); color: var(--fg-soft); max-width: 60ch;">
      {ui('topics.description', lang)}
    </p>
  </section>

  <section class="container article-body" style="padding-bottom: 3rem; max-width: 860px;">
    <h2>How to navigate the topics</h2>
    <p>These topics act as coverage maps for Produto com IA. Each page brings together concepts, newsletters, guides, and frequently asked questions around a recurring product or technology problem, so a specific question can lead to a fuller explanation.</p>
    <p>Use the maps to find patterns across stories that may look disconnected on their own. AI adoption depends on strategy and operating change; agents depend on evaluation and oversight; costs depend on architecture, volume, and delivered value. This structure helps separate a trend, a tool, and a decision.</p>
    <p>The counts on each card indicate the current depth of coverage. For a quick definition, visit the <a href="/en/concepts/">concepts</a>; to apply the knowledge, continue to the related <a href="/en/guides/">practical guides</a>.</p>
    <p>Within each map, follow the links between pages and use the frequently asked questions to shape the next investigation. The goal is to shorten the path between finding information and understanding its impact on a product.</p>
    <p>This reading also reveals gaps: a topic with many news items but few explanations may need a new guide, while a recurring question can become a definition or a durable reference.</p>
  </section>

  <section class="container" style="padding-bottom: 4rem;">
    <div class="grid grid-3">
      {topics.map((topic, i) => (
        <a href={`/en/topics/${t(topic.slug, lang)}`} class="topic-card">
          <span class="topic-card__num">T.{String(i + 1).padStart(2, '0')} / {String(topics.length).padStart(2, '0')}</span>
          <h3 class="topic-card__title">{t(topic.name, lang)}</h3>
          <p class="topic-card__desc">{t(topic.shortDescription, lang)}</p>
          <span class="topic-card__count">{topic.faqs.length} {ui('section.questions', lang)} · {ta(topic.keywords, lang).length} {ui('section.keywords', lang)} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
