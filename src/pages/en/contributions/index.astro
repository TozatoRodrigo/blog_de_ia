---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContributionCard from '../../../components/ContributionCard.astro';
import { contributionIndexPath, contributionPath } from '../../../utils/contribution-routes';
import { itemListSchema } from '../../../utils/schema';

const lang = 'en' as const;
const contributions = await getCollection('contributions-en', ({ data }) => !data.draft);
contributions.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.localeCompare(a.data.date));
const title = 'Editorial contributions';
const description = 'Ideas, experiences, and lessons from people building products with artificial intelligence. A section for publishing invited voices with clear authorship, context, and credit.';
const jsonLd = itemListSchema({
  name: title,
  url: contributionIndexPath(lang),
  lang,
  items: contributions.map((entry) => ({ name: entry.data.title, description: entry.data.excerpt, url: contributionPath(lang, entry.data.seoSlug) })),
});
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} lang={lang} alternateUrl="/contribuicoes/">
  <section class="container contribution-index__intro">
    <span class="mono" style="color: var(--accent);">[ INVITED VOICES ]</span>
    <h1>{title}</h1>
    <p>{description}</p>
    <p>This is an editorial track independent from the newsletter and guides. Every published text keeps the perspective of its author, with an author profile that makes the context, links, and responsibility for the contribution clear. The goal is to bring different experiences in product, agents, and AI governance closer together.</p>
  </section>

  <section class="container contribution-index__list" aria-labelledby="published-contributions">
    <div class="section-header">
      <h2 id="published-contributions">Published contributions</h2>
      <span class="mono" style="color: var(--fg-muted);">{contributions.length} {contributions.length === 1 ? 'contribution' : 'contributions'}</span>
    </div>
    {contributions.length > 0 ? (
      <div class="grid grid-2">{contributions.map((entry) => <ContributionCard entry={entry} lang={lang} />)}</div>
    ) : (
      <div class="contribution-empty"><h3>The first contribution is on its way</h3><p>This section is still growing. If you have an experience or an idea to share, send your text for editorial review.</p></div>
    )}
  </section>

  <section class="container contribution-index__cta" aria-labelledby="contribute-heading">
    <span class="mono" style="color: var(--accent);">[ NEW VOICE ]</span>
    <h2 id="contribute-heading">Have a contribution to publish?</h2>
    <p>We accept complete pieces about product, agents, evaluation, and AI governance. Every submission goes through editorial review before anything is published.</p>
    <a class="btn btn--primary" href="/en/contribute/">CONTRIBUTE →</a>
  </section>
</BaseLayout>

<style>
  .contribution-index__intro { padding-top: 4rem; padding-bottom: 2rem; }
  .contribution-index__intro h1 { max-width: 13ch; }
  .contribution-index__intro p { max-width: 70ch; color: var(--fg-soft); font-size: var(--step-1); line-height: 1.65; }
  .contribution-index__list { padding-bottom: 4rem; }
  .contribution-index__cta { padding: 3rem 0 5rem; border-top: 2px solid var(--line); }
  .contribution-index__cta p { max-width: 60ch; color: var(--fg-soft); font-size: var(--step-1); }
  .contribution-empty { border: 2px dashed var(--line); padding: 2rem; max-width: 760px; }
  .contribution-empty p { color: var(--fg-soft); }
</style>
