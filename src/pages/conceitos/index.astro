---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { concepts } from '../../data/concepts';
import { t } from '../../i18n/lang';
import { ui } from '../../i18n/ui';
import { definedTermSetSchema } from '../../utils/schema';

const lang = 'pt-BR' as const;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${ui('concepts.title', lang)} — Produto com IA`, description: ui('concepts.description', lang), url: 'https://produtocomia.com.br/conceitos' },
  definedTermSetSchema({
    name: ui('concepts.title', lang), description: ui('concepts.description', lang), url: '/conceitos/', lang,
    terms: concepts.map((concept) => ({
      name: t(concept.term, lang), description: t(concept.longDescription, lang), url: `/conceitos/${t(concept.slug, lang)}/`,
    })),
  }),
];
const categories = [...new Set(concepts.map((c) => t(c.category, lang)))].sort();
---

<BaseLayout title={ui('concepts.title', lang)} description={ui('concepts.description', lang)} jsonLd={jsonLd} lang={lang} alternateUrl="/en/concepts">
  <section class="container" style="padding-top: 3rem; padding-bottom: 2rem;">
    <div class="section-header"><div><span class="mono" style="color: var(--accent);">[ {ui('concepts.glossary', lang)} ]</span><h1>{ui('concepts.title', lang)}</h1></div><span class="mono" style="color: var(--fg-muted);">{concepts.length} {ui('concepts.terms', lang)}</span></div>
    <p style="font-size: var(--step-1); color: var(--fg-soft); max-width: 60ch;">{ui('concepts.description', lang)}</p>
  </section>
  <section class="container article-body" style="padding-bottom: 3rem; max-width: 860px;">
    <h2>Como usar este glossário de IA</h2>
    <p>Este glossário traduz termos que aparecem em discussões de produto, engenharia e operações de inteligência artificial. Cada definição começa pelo significado direto e avança para o contexto necessário para tomar uma decisão: quando o conceito é útil, quais limites devem ser observados e que tipo de evidência ajuda a avaliar uma implementação.</p>
    <p>Use a página para alinhar linguagem entre produto, dados, segurança e negócio. Em vez de tratar um termo como promessa, procure a relação entre capacidade, custo, risco e resultado. Conceitos como RAG, tool calling, avaliação e inferência têm implicações diferentes para arquitetura, experiência do usuário e governança.</p>
    <p>As entradas são atualizadas quando novas fontes mudam a explicação ou quando um exemplo operacional ajuda a evitar interpretações equivocadas. Para uma visão aplicada, combine este glossário com os <a href="/guias/">guias de IA</a> e com os <a href="/topicos/">mapas de tópicos</a>.</p>
  </section>
  {categories.map((category) => {
    const categoryConcepts = concepts.filter((c) => t(c.category, lang) === category);
    return (
      <section class="container" style="padding-bottom: 3rem;">
        <div class="divider-label"><span>{category.toUpperCase()} — {categoryConcepts.length} {ui('concepts.terms', lang)}</span></div>
        <div class="grid grid-2">
          {categoryConcepts.map((concept) => (
            <a href={`/conceitos/${t(concept.slug, lang)}`} class="topic-card">
              <span class="topic-card__num">{t(concept.category, lang)}</span>
              <h3 class="topic-card__title" style="font-size: 1.25rem;">{t(concept.term, lang)}</h3>
              <p class="topic-card__desc">{t(concept.definition, lang).slice(0, 140)}...</p>
              <span class="topic-card__count">{ui('concept.readDef', lang)} →</span>
            </a>
          ))}
        </div>
      </section>
    );
  })}
</BaseLayout>
