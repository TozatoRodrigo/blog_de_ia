---
import { SITE } from '../config';
import type { Lang } from '../i18n/lang';

interface Props {
  class?: string;
  lang?: Lang;
  direct?: boolean;
}

const { class: className = '', lang = 'pt-BR', direct = false } = Astro.props;
const [user, domain] = SITE.email.split('@');
const fallbackLabel = lang === 'en' ? 'Editor email' : 'E-mail do editor';
const ariaLabel = lang === 'en' ? 'Email the editor' : 'Enviar e-mail ao editor';
---

{direct ? (
  <a class={className} data-contact-direct="true" href={`mailto:${SITE.email}`} aria-label={ariaLabel}>{SITE.email}</a>
) : (
  <span
    class={className}
    data-contact-email
    data-contact-user={user}
    data-contact-domain={domain}
    data-contact-aria-label={ariaLabel}
    aria-label={fallbackLabel}
  >{fallbackLabel}</span>
)}
