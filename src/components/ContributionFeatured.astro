---
import type { CollectionEntry } from 'astro:content';
import type { Contributor } from '../data/contributors';
import type { Lang } from '../i18n/lang';
import { ui } from '../i18n/ui';
import { contributionPath } from '../utils/contribution-routes';
import { formatDate } from '../utils/format';

type ContributionEntry = CollectionEntry<'contributions'> | CollectionEntry<'contributions-en'>;

interface Props {
  lang: Lang;
  featuredEntry?: ContributionEntry;
  featuredAuthor?: Contributor;
}

const { lang, featuredEntry, featuredAuthor } = Astro.props;
const featurePath = featuredEntry ? contributionPath(lang, featuredEntry.data.seoSlug) : '';
---

{featuredEntry && featuredAuthor && (
  <section class="contribution-featured-wrap">
    <article class="contribution-featured" data-contribution-featured>
      <div class="contribution-featured__signal">
        <span class="mono-sm">{ui('contribution.featuredLabel', lang)}</span>
        <span class="contribution-featured__rule" aria-hidden="true"></span>
        <time datetime={featuredEntry.data.date}>{formatDate(featuredEntry.data.date, lang)}</time>
      </div>
      <div class="contribution-featured__body">
        <div class="contribution-featured__heading">
          <span class="mono" style="color: var(--accent);">{ui('contribution.featuredTitle', lang)}</span>
          <h2><a href={featurePath}>{featuredEntry.data.title}</a></h2>
          <p>{featuredEntry.data.excerpt}</p>
        </div>
        <div class="contribution-featured__meta">
          <span>{ui('contribution.by', lang)} <strong>{featuredAuthor.name}</strong></span>
          <a class="btn btn--accent" href={featurePath}>{ui('contribution.read', lang)} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </article>
  </section>
)}

<style>
  .contribution-featured-wrap {
    width: 100%;
    max-width: var(--grid-max);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .contribution-featured {
    display: grid;
    grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 1fr);
    border: 3px solid var(--line);
    background: var(--bg);
    overflow: hidden;
  }
  .contribution-featured__signal {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--accent);
    color: var(--fg-invert);
  }
  .contribution-featured__signal .mono-sm,
  .contribution-featured__signal time { color: var(--fg-invert); }
  .contribution-featured__rule { width: 3rem; height: 3px; margin-top: auto; background: var(--fg-invert); }
  .contribution-featured__signal time { font-family: var(--font-mono); font-size: var(--step--1); }
  .contribution-featured__body { display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; min-width: 0; padding: clamp(1.5rem, 4vw, 3rem); }
  .contribution-featured__heading h2 { margin: 0.75rem 0 1rem; max-width: 18ch; font-size: var(--step-3); line-height: 0.95; text-transform: none; overflow-wrap: anywhere; }
  .contribution-featured__heading h2 a { border: 0; }
  .contribution-featured__heading h2 a:hover { padding: 0; color: var(--accent); background: none; }
  .contribution-featured__heading p { max-width: 64ch; margin: 0; color: var(--fg-soft); line-height: 1.55; }
  .contribution-featured__meta { display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; flex-wrap: wrap; padding-top: 1.25rem; border-top: 2px solid var(--line); font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .contribution-featured__meta strong { color: var(--accent-dark); }
  .contribution-featured .btn { white-space: nowrap; }

  @media (max-width: 720px) {
    .contribution-featured { grid-template-columns: 1fr; }
    .contribution-featured__signal { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 0.75rem 1rem; }
    .contribution-featured__rule { width: 2rem; margin-top: 0; }
  }
  @media (max-width: 480px) {
    .contribution-featured .btn { width: 100%; justify-content: center; }
    .contribution-featured__body { padding: 1.25rem; }
  }
</style>
